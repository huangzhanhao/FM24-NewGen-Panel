{
  "providers": [
    {
      "id": "openai",
      "kind": "openai",
      "name": "OpenAI",
      "baseUrl": "https://api.openai.com/v1",
      "defaultModel": "gpt-image-1",
      "models": [
        {
          "model": "gpt-image-1",
          "capabilities": {
            "sizes": ["1024x1024", "1024x1536", "1536x1024"],
            "maxN": 10,
            "supportsQuality": true,
            "supportsSeed": false,
            "supportsSteps": false,
            "supportsNegativePrompt": false,
            "supportsResponseFormat": false,
            "qualities": ["low", "medium", "high", "auto"]
          }
        }
      ]
    }
  ],
  "_comment": "dashscope（阿里云百炼）、volcano（火山方舟豆包 Seedream）、siliconflow（硅基流动）、modelscope（魔搭）四个服务商及模型目录均由 Rust 代码内置（image_ai_providers/ 下对应文件），不在本文件维护；运行时自动注入（缺失即整块补入，已存在只归位 kind）。",
  "settings": {
    "defaultProviderId": "openai",
    "historyLimit": 20,
    "galleryRecordLimit": 100,
    "concurrency": 2,
    "namingPattern": "{uid}_{index}"
  }
}
